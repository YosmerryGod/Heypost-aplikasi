{
  "expo": {
    "name": "HeyPost",
    "slug": "heypost-aplikasi",
    "scheme": "heypost",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Izinkan HeyPost menggunakan Face ID untuk melindungi sesi akun."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tech.doodweb.heypost"
    },
    "android": {
      "package": "tech.doodweb.heypost"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ec28fa30-ca43-4e2c-9b32-5392eb51ec81"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ec28fa30-ca43-4e2c-9b32-5392eb51ec81"
    }
  }
}
