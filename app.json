{
  "expo": {
    "name": "HeyPost",
    "slug": "heypost-aplikasi",
    "scheme": "heypost",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#040404"
        }
      ],
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Izinkan HeyPost menggunakan Face ID untuk melindungi sesi akun."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan HeyPost mengakses kamera untuk memindai barcode karyawan.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tech.doodweb.heypost"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "tech.doodweb.heypost",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#040404"
      }
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ec28fa30-ca43-4e2c-9b32-5392eb51ec81"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ec28fa30-ca43-4e2c-9b32-5392eb51ec81"
    },
    "icon": "./assets/icon.png"
  }
}
